---
const {slug}=Astro.props;
---
<div class="panel" data-tool={slug}>
{['image-resizer','image-compressor','webp-converter'].includes(slug) && <div class="space-y-5"><label class="field">Choose an image<input id="image" type="file" accept="image/png,image/jpeg,image/webp,image/avif"/></label>{slug==='image-resizer'&&<div class="grid grid-cols-2 gap-4"><label class="field">Width (px)<input id="width" type="number" min="1" max="10000" value="1200"/></label><label class="field">Height (px)<input id="height" type="number" min="1" max="10000" value="800"/></label></div>}{slug==='image-compressor'&&<label class="field">JPEG quality <input id="quality" type="range" min="10" max="95" value="75"/><span class="hint">Lower quality generally means smaller files.</span></label>}<button id="run">Process image</button><p class="hint">Your image stays in this browser tab. Animated images are not preserved.</p><p id="details" class="hint" aria-live="polite"></p><img id="preview" alt="Processed image preview" class="max-h-80 rounded-lg hidden"/><a id="download" class="btn hidden" download>Download image</a></div>}
{slug==='qr-code-generator'&&<div class="space-y-5"><label class="field">Text or URL<textarea id="qrtext" rows="3" placeholder="https://example.com"></textarea></label><button id="run">Generate QR code</button><div id="qr-output" class="w-fit"></div><a id="download" class="btn hidden" download="qr-code.png">Download PNG</a><p class="hint">QR content is encoded directly into the image. Verify it scans before printing.</p></div>}
{slug==='color-palette-generator'&&<div class="space-y-5"><label class="field">Base color<input type="color" id="base" value="#635bff" class="!h-14"/></label><button id="run">Generate palette</button><div id="palette" class="grid grid-cols-2 sm:grid-cols-5 gap-3"></div><p class="hint">Select a color swatch to copy its hex code. Check contrast before using colors for text.</p></div>}
{slug==='css-gradient-generator'&&<div class="space-y-5"><div class="grid grid-cols-2 gap-4"><label class="field">Start color<input type="color" id="start" value="#635bff" class="!h-14"/></label><label class="field">End color<input type="color" id="end" value="#ec4899" class="!h-14"/></label></div><label class="field">Angle (degrees)<input type="range" id="angle" min="0" max="360" value="135"/></label><div id="gradient" class="h-52 rounded-xl border"></div><label class="field">CSS code<textarea readonly id="css" rows="2"></textarea></label><button id="copy">Copy CSS</button></div>}
{slug==='invoice-generator'&&<div class="space-y-5"><div class="grid sm:grid-cols-2 gap-4"><label class="field">Your business name<input id="from" autocomplete="organization"/></label><label class="field">Client name<input id="client"/></label><label class="field">Invoice number<input id="number" value="INV-001"/></label><label class="field">Invoice date<input id="date" type="date"/></label><label class="field">Currency code<input id="currency" maxlength="3" value="USD"/></label><label class="field">Payment due date<input id="due" type="date"/></label></div><h2 class="font-bold text-xl">Line items</h2><div id="items" class="space-y-3"><div class="grid grid-cols-1 sm:grid-cols-12 gap-2 item"><label class="field sm:col-span-6">Description<input class="desc" placeholder="Design services"/></label><label class="field sm:col-span-3">Quantity<input class="qty" type="number" min="0" step="0.01" value="1"/></label><label class="field sm:col-span-3">Rate<input class="rate" type="number" min="0" step="0.01" value="100"/></label></div></div><button id="add" type="button">Add line item</button><label class="field">Notes<textarea id="notes" rows="3" placeholder="Payment instructions or project details"></textarea></label><button id="run" type="button">Create invoice</button><div id="invoice" class="hidden border rounded-xl p-6 bg-white"></div><button id="print" type="button" class="hidden">Print / Save as PDF</button><p class="hint">Invoice details stay in your browser. Verify numbering, taxes, legal requirements and payment information yourself.</p></div>}
<p id="status" role="status" aria-live="polite" class="text-sm text-slate-600 mt-5"></p></div>
<script>
import QRCode from 'qrcode';
const root=document.querySelector<HTMLElement>('[data-tool]');
if(root){const $=(s:string)=>root.querySelector<HTMLElement>(s)!;const val=(s:string)=>(root.querySelector<HTMLInputElement|HTMLTextAreaElement>(s)?.value||'');const status=(s:string)=>{$('#status').textContent=s};const tool=root.dataset.tool;
const download=$('#download') as HTMLAnchorElement|null;
if(['image-resizer','image-compressor','webp-converter'].includes(tool||'')){$('#run').addEventListener('click',async()=>{const file=(root.querySelector<HTMLInputElement>('#image')!).files?.[0];if(!file)return status('Choose an image first.');if(file.size>30*1024*1024)return status('Choose an image smaller than 30 MB.');let bitmap:ImageBitmap|undefined;try{bitmap=await createImageBitmap(file);const w=tool==='image-resizer'?Number(val('#width')):bitmap.width;const h=tool==='image-resizer'?Number(val('#height')):bitmap.height;if(!Number.isInteger(w)||!Number.isInteger(h)||w<1||h<1||w>10000||h>10000||w*h>40_000_000)throw Error('Dimensions must be valid and under 40 megapixels.');const canvas=document.createElement('canvas');canvas.width=w;canvas.height=h;const ctx=canvas.getContext('2d');if(!ctx)throw Error('Canvas is unavailable.');ctx.drawImage(bitmap,0,0,w,h);const type=tool==='webp-converter'?'image/webp':tool==='image-compressor'?'image/jpeg':file.type==='image/png'?'image/png':'image/jpeg';const quality=tool==='image-compressor'?Number(val('#quality'))/100:0.9;const blob=await new Promise<Blob|null>(resolve=>canvas.toBlob(resolve,type,quality));if(!blob)throw Error('Image export failed.');if(blob.type!==type)throw Error('This browser does not support the requested output format.');const url=URL.createObjectURL(blob);const preview=$('#preview') as HTMLImageElement;const old=preview.dataset.url;if(old)URL.revokeObjectURL(old);preview.src=url;preview.dataset.url=url;preview.classList.remove('hidden');if(download){download.href=url;download.download=file.name.replace(/\.[^.]+$/,'')+(type==='image/webp'?'.webp':type==='image/png'?'.png':'.jpg');download.classList.remove('hidden')}$('#details').textContent=`${w} × ${h} pixels • ${(blob.size/1024).toFixed(1)} KB (original ${(file.size/1024).toFixed(1)} KB)`;status('Image ready.')}catch(e){status(e instanceof Error?e.message:'Unable to process image.')}finally{bitmap?.close()}})}
if(tool==='qr-code-generator'){$('#run').addEventListener('click',async()=>{const t=val('#qrtext').trim();if(!t)return status('Enter text or a URL.');if(t.length>2000)return status('Please use 2,000 characters or fewer.');try{const url=await QRCode.toDataURL(t,{width:320,margin:2,errorCorrectionLevel:'M'});const img=document.createElement('img');img.src=url;img.alt='Generated QR code';$('#qr-output').replaceChildren(img);if(download){download.href=url;download.classList.remove('hidden')}status('QR code ready.')}catch{status('Unable to encode this text. Try a shorter value.')}})}
if(tool==='color-palette-generator'){const render=()=>{const base=val('#base');const hue=parseInt(base.slice(1,3),16);const colors=[base,...[35,75,115,155].map(n=>`#${[0,1,2].map(i=>Math.round((parseInt(base.slice(1+i*2,3+i*2),16)+n)%256).toString(16).padStart(2,'0')).join('')}`)];$('#palette').replaceChildren(...colors.map(c=>{const b=document.createElement('button');b.type='button';b.style.background=c;b.style.minHeight='110px';b.style.color='#fff';b.textContent=c;b.setAttribute('aria-label',`Copy ${c}`);b.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(c);status(`${c} copied`)}catch{status(`Copy manually: ${c}`)}});return b}));status('Palette ready.')};$('#run').addEventListener('click',render);render()}
if(tool==='css-gradient-generator'){const render=()=>{const css=`linear-gradient(${val('#angle')}deg, ${val('#start')}, ${val('#end')})`;($('#gradient') as HTMLElement).style.background=css;(root.querySelector<HTMLTextAreaElement>('#css')!).value=`background: ${css};`};['#angle','#start','#end'].forEach(s=>$(s).addEventListener('input',render));$('#copy').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(val('#css'));status('CSS copied.')}catch{status('Select the CSS field to copy manually.')}});render()}
if(tool==='invoice-generator'){$('#add').addEventListener('click',()=>{const original=$('.item');const clone=original.cloneNode(true) as HTMLElement;clone.querySelectorAll('input').forEach((input)=>{(input as HTMLInputElement).value=input.classList.contains('qty')?'1':input.classList.contains('rate')?'0':''});$('#items').append(clone)});$('#run').addEventListener('click',()=>{const currency=val('#currency').toUpperCase();if(!/^[A-Z]{3}$/.test(currency))return status('Enter a three-letter currency code.');const rows=[...root.querySelectorAll<HTMLElement>('.item')].map(r=>({desc:(r.querySelector<HTMLInputElement>('.desc')?.value||'').trim(),qty:Number(r.querySelector<HTMLInputElement>('.qty')?.value),rate:Number(r.querySelector<HTMLInputElement>('.rate')?.value)}));if(rows.some(r=>!r.desc||!Number.isFinite(r.qty)||!Number.isFinite(r.rate)||r.qty<0||r.rate<0))return status('Complete each line item with non-negative numbers.');const fmt=(n:number)=>new Intl.NumberFormat('en',{style:'currency',currency}).format(n);const container=$('#invoice');container.replaceChildren();const line=(label:string,value:string)=>{const p=document.createElement('p');const strong=document.createElement('strong');strong.textContent=label+': ';p.append(strong,document.createTextNode(value));container.append(p)};const heading=document.createElement('h2');heading.className='text-3xl font-bold mb-4';heading.textContent='INVOICE';container.append(heading);[['From',val('#from')],['Bill to',val('#client')],['Invoice #',val('#number')],['Date',val('#date')],['Due',val('#due')]].forEach(([a,b])=>line(a,b));const table=document.createElement('table');table.className='w-full mt-6 text-left';const header=document.createElement('tr');['Description','Qty','Rate','Amount'].forEach(t=>{const th=document.createElement('th');th.textContent=t;th.className='p-2 border-b';header.append(th)});table.append(header);rows.forEach(r=>{const tr=document.createElement('tr');[r.desc,String(r.qty),fmt(r.rate),fmt(r.qty*r.rate)].forEach(v=>{const td=document.createElement('td');td.textContent=v;td.className='p-2 border-b';tr.append(td)});table.append(tr)});container.append(table);line('Total',fmt(rows.reduce((sum,r)=>sum+r.qty*r.rate,0)));line('Notes',val('#notes'));container.classList.remove('hidden');$('#print').classList.remove('hidden');status('Invoice ready. Review before printing.')});$('#print').addEventListener('click',()=>window.print())}
}
</script>
