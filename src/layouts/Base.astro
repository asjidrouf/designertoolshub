---
import '../styles/global.css';
const {title='Designer Tools Hub',description='Free browser-based tools for designers and freelancers.',canonical=Astro.url.pathname}=Astro.props;
const site=Astro.site?.toString() || 'https://example.com';
const canonicalUrl=new URL(canonical,site).toString();
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#5949e8"/><title>{title} | Designer Tools Hub</title><meta name="description" content={description}/><link rel="canonical" href={canonicalUrl}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonicalUrl}/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebSite',name:'Designer Tools Hub',url:site})}/></head><body><header class="bg-white border-b border-slate-200"><nav aria-label="Main navigation" class="max-w-6xl mx-auto px-5 py-5 flex items-center justify-between gap-4"><a href={import.meta.env.BASE_URL + ''} class="font-black tracking-tight text-xl text-indigo-700">✦ Designer Tools Hub</a><div class="flex gap-4 text-sm font-semibold"><a href={import.meta.env.BASE_URL + '#tools'}>Tools</a><a href={import.meta.env.BASE_URL + 'about/'}>About</a><a href={import.meta.env.BASE_URL + 'contact/'}>Contact</a></div></nav></header><main><slot/></main><footer class="border-t bg-white mt-20"><div class="max-w-6xl mx-auto px-5 py-10 flex flex-wrap gap-x-6 gap-y-3 text-sm text-slate-600"><a href={import.meta.env.BASE_URL + 'about/'}>About</a><a href={import.meta.env.BASE_URL + 'contact/'}>Contact</a><a href={import.meta.env.BASE_URL + 'privacy/'}>Privacy Policy</a><a href={import.meta.env.BASE_URL + 'terms/'}>Terms</a><span>Files are processed in your browser where supported.</span></div></footer></body></html>
