import Base from '../layouts/Base.astro';
---
<Base title="Contact" description="Report a bug or request a feature for Designer Tools Hub."><article class="max-w-3xl mx-auto px-5 py-16"><h1 class="text-4xl font-black mb-6">Contact</h1><p class="text-lg leading-relaxed text-slate-700">Report a bug or suggest a feature on <a class="underline" href="https://github.com/asjidrouf/designertoolshub/issues">our GitHub issue tracker</a>. A GitHub account is needed to post. Include your browser and steps to reproduce the issue. Please do not share private images, invoice details or other sensitive information.</p></article></Base>
