---
import Base from '../layouts/Base.astro';import {tools} from '../lib/tools';
---
<Base title="Free Designer Tools" description="Free image, QR, color, gradient and freelance invoice tools that work in your browser."><section class="bg-gradient-to-br from-indigo-950 via-indigo-800 to-violet-700 text-white"><div class="max-w-6xl mx-auto px-5 py-24"><p class="uppercase tracking-widest text-indigo-200 text-sm font-bold">Design faster. Create freely.</p><h1 class="text-4xl md:text-6xl font-black max-w-3xl mt-5 leading-tight">Everyday creative tools, all in one place.</h1><p class="text-indigo-100 mt-6 max-w-2xl text-lg">Resize, compress, convert, generate and invoice with simple tools designed for your workflow. No sign-up required.</p><a class="btn mt-8 !bg-white !text-indigo-900" href="#tools">Explore tools</a></div></section><section id="tools" class="max-w-6xl mx-auto px-5 py-16"><h2 class="text-3xl font-black mb-3">Explore free tools</h2><p class="text-slate-600 mb-8">Choose a tool to get started.</p><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">{tools.map((t,i)=><a href={`/tools/${t.slug}/`} class="panel hover:border-indigo-400 transition-colors block"><span class="text-3xl" aria-hidden="true">{['▣','◫','◇','▦','◉','◈','▤'][i]}</span><h3 class="text-xl font-bold mt-4">{t.name}</h3><p class="text-slate-600 mt-2">{t.description}</p><span class="text-indigo-700 font-semibold inline-block mt-5">Open tool →</span></a>)}</div></section><section class="max-w-6xl mx-auto px-5"><div class="panel"><h2 class="text-2xl font-bold">Designed for privacy</h2><p class="text-slate-600 mt-3">These tools run in your browser and do not send uploaded images or invoice data to our application server. External hosting infrastructure may still receive ordinary web requests. Review our <a class="underline" href="/privacy/">Privacy Policy</a> for details.</p></div></section></Base>
